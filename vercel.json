{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
   "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://zamorin-cafe-erp-backend.onrender.com/api/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/frontend/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/(assets|src|cafe-operations|dist)/(.*)",
      "dest": "/frontend/$1/$2",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/cafe-operations",
      "dest": "/frontend/cafe-operations/cafe-operations.html"
    },
    {
      "src": "/manifest.json",
      "dest": "/frontend/manifest.json"
    },
    {
      "src": "/robots.txt",
      "dest": "/frontend/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/frontend/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  ]
}
